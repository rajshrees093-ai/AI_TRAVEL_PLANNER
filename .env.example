# ==============================================================================
# ROAMWISE — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your credentials.
# If keys are omitted, RoamWise automatically runs in a clearly labeled
# Demonstration Mode using curated local destination & routing datasets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPENAI API (Server-Only — Never expose to client browser)
# Used by Stage 3 of the Core AI Travel Generation Engine & Conversational Editor
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM KEYS
# IMPORTANT SECURITY SEPARATION:
# - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Browser key restricted by HTTP Referrer
#   (e.g. https://yourdomain.com/*, http://localhost:3000/*) and limited strictly
#   to "Maps JavaScript API".
# - GOOGLE_MAPS_SERVER_KEY: Server-only key restricted by IP address and limited
#   to "Places API (New)" and "Routes API". Never prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYourBrowserRestrictedMapsJavaScriptKey"
GOOGLE_MAPS_SERVER_KEY="AIzaSyYourServerRestrictedPlacesAndRoutesKey"

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & POSTGRESQL DATABASE
# Obtain from Supabase Dashboard -> Project Settings -> API & Database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# PostgreSQL connection strings for Prisma ORM & migrations
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SHARE_TOKEN_SECRET="replace-with-a-32-byte-random-hex-secret-for-share-tokens"
